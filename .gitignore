# Generated firmware and ESP-IDF / PlatformIO outputs
/app/build/
/bootloader/build/
/tools/esp32/.pio/
/tools/esp32/build/
/tools/esp32/managed_components/
/tools/esp32/sdkconfig
/tools/esp32/sdkconfig.*
!/tools/esp32/sdkconfig.defaults
!/tools/esp32/sdkconfig.defaults.*

# Emulator traces and local firmware/EEPROM inputs
/emu/output/
/emu/inputs/

# Local scans (raw document data, previews and per-scan logs)
/scans/
/app/scans/

# Generated artifacts in app milestone archives. Keep their source snapshots,
# manifests, validation reports and reviewed logs available to Git.
/app/evidence/**/*.bin
/app/evidence/**/*.elf
/app/evidence/**/*.map
/app/evidence/**/*.dis
/app/evidence/**/scan.pgm
/app/evidence/**/scan.png
/app/evidence/**/scan-raw.png

# Python environments, bytecode and tool caches
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Local editor state and generated C/C++ indexing configuration
.idea/
.vscode/c_cpp_properties.json
.vscode/.browse.c_cpp.db*
.vscode/ipch/
*.code-workspace
*.swp
*.swo
*~

# macOS metadata
.DS_Store
._*

# Keep reference firmware dumps, SDK defaults, and evidence JSON/logs versionable.
# Do not add blanket *.bin, *.json or *.log exclusions.
