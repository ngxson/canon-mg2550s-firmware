+{
+    uint32_t control = control_read(), zero = 0;
+    if (!(control & CP15_CONTROL_ICACHE)) return false;         /* needs the protection unit (I-cache switch) */
+    if (!!(control & CP15_CONTROL_DCACHE) == on) return true;
